# ============================================================================
# REIUTAROU — environment variables (copy ke .env.local, isi nilainya)
# JANGAN commit .env.local. Jangan pernah expose secret ke kode frontend.
# ============================================================================

# --- Supabase (isi setelah membuat project di Phase 4) ----------------------
# Public URL & anon key — aman untuk dipakai di client (browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Situs -------------------------------------------------------------------
# Base URL publik (untuk redirect email verifikasi / reset password).
# Diisi https://domain-mu bila production; default localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Server-only secrets (TIDAK BOLEH dipakai/diekspos di frontend) ---------
SUPABASE_SERVICE_ROLE_KEY=

# --- Opsional: Payment gateway (diisi ketika V2 / Phase 8+) ------------------
# PAYMENT_GATEWAY_KEY=
# PAYMENT_WEBHOOK_SECRET=